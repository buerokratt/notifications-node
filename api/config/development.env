# End-user SSE presence lease; must exceed the heartbeat interval.
PRESENCE_LEASE_SECONDS=45
# Wait after the last end-user connection expires before shadow termination.
TERMINATION_GRACE_SECONDS=10
# Delay between lifecycle worker polls, in milliseconds.
LIFECYCLE_POLL_INTERVAL_MS=500
# Maximum lifecycle actions claimed in one worker poll.
LIFECYCLE_BATCH_SIZE=20
# Lease shared by claimed and processing lifecycle actions; must exceed callback timeout plus safety margin.
LIFECYCLE_ACTION_LEASE_SECONDS=30
# Maximum number of termination callback attempts.
LIFECYCLE_MAX_ATTEMPTS=5

NODE_ENV=development
